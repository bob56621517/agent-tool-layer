# agent-tool-layer —— 联网搜索工具层后端 环境变量示例
# 复制为 .env 后按需填写;docker compose 会自动读取同目录下的 .env。

# ---------- 必需 ----------

# SearXNG 服务端密钥(用于签名,必须设置且保持私密)
# 可用 openssl rand -hex 32 生成
SEARXNG_SECRET="change-me-to-a-long-random-hex-string"

# ---------- 可选(不填则对应能力降级) ----------

# 博查(Bocha)API Key,付费兜底搜索的启动兜底 key。
# 不填时 bocha 引擎仍启用;调用方可用 X-Bocha-Api-Key 动态传 key。
# 若你的 shell 已设置 BOCHA_API_KEY,compose 会直接读取,无需在此填写。
BOCHA_API_KEY=""

# GitHub Token。github(仓库)引擎无需认证;github_code(代码)引擎默认走匿名(限流较严)。
# 设了 GITHUB_TOKEN 则由 entrypoint 自动注入 github_code 引擎(走认证,配额高)。
# 不设则回退匿名限流。token 经 env 注入,不进仓库。
GITHUB_TOKEN=""

# ---------- 端口(默认即可,可调) ----------

# 对外暴露的唯一端口(nginx 入口)
INGRESS_PORT=28082

# 限流(nginx 层,按客户端 IP)。默认 10 请求/秒,突发 20;可在 nginx/nginx.conf 调整 rate/burst。
# 如需放宽或收紧,编辑 docker/nginx/nginx.conf 里的 limit_req_zone / limit_req。

# ---------- 镜像(默认即可,可覆盖) ----------

# 入口 nginx 镜像(默认官方 nginx-unprivileged 非 root 版;可换 nginx:stable 等)
NGINX_IMAGE="ghcr.io/nginxinc/nginx-unprivileged:1.27-alpine"
